# Frontend (React + Vite) — build multi-stage; el resultado son archivos
# estáticos servidos por nginx sin privilegios (corre bien en Podman
# rootless). Compatible con `podman build` y `docker build` por igual.
#
# IMPORTANTE: Vite incrusta VITE_API_URL en el JavaScript en tiempo de
# build, no de arranque del contenedor. Debe apuntar a donde el
# *navegador* del usuario puede alcanzar al backend (normalmente el puerto
# publicado en el host, ej. http://localhost:9090/api/v1), no al nombre del
# contenedor en la red de Podman. Pásalo con --build-arg:
#
#   podman build --build-arg VITE_API_URL=http://localhost:9090/api/v1 -t taqueria-frontend .

FROM docker.io/library/node:22-alpine AS build
WORKDIR /src

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG VITE_API_URL=http://localhost:9090/api/v1
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY podman/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 4321
