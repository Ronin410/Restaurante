# URL base de la API del backend. En desarrollo apunta directo al backend Go
# (puerto 9090, no el 8080 típico — ver PODMAN.md); en producción normalmente
# se deja vacío y se sirve el frontend detrás de un proxy inverso que expone
# la API en /api/v1 en el mismo origen.
#
# Ojo con Podman/contenedores: Vite incrusta este valor en el JavaScript en
# tiempo de build (npm run build / podman build --build-arg), no al arrancar
# el contenedor. Debe apuntar a donde el *navegador* puede alcanzar al
# backend (el puerto publicado en el host), no al nombre del contenedor.
VITE_API_URL=http://localhost:9090/api/v1
