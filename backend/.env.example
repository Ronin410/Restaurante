# Backend (API Go). Puertos elegidos fuera de los "comunes" a propósito
# (ver PODMAN.md) para no chocar con otros servicios en la misma máquina.
PORT=9090

# Conexión a PostgreSQL: o defines DATABASE_URL completo...
# DATABASE_URL=postgres://taqueria:taqueria@localhost:6543/taqueria?sslmode=disable
# ...o las variables sueltas (se usan si DATABASE_URL no está definida):
PGHOST=localhost
PGPORT=6543
PGUSER=taqueria
PGPASSWORD=taqueria
PGDATABASE=taqueria
PGSSLMODE=disable

JWT_SECRET=cambia-este-secreto-en-produccion
ALLOWED_ORIGIN=http://localhost:4321
